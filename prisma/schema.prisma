generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Discord сервера
model Guild {
  id              String          @id // Discord Guild ID
  name            String
  iconUrl         String?
  ownerId         String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  moderationLogs  ModerationLog[]
  admins          Admin[]
}

// Пользователи Discord
model User {
  id                    String          @id // Discord User ID
  username              String
  discriminator         String          @default("0")
  avatarUrl             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  // Логи где пользователь является целью
  targetLogs            ModerationLog[] @relation("TargetUser")
  // Логи где пользователь является модератором
  moderatorLogs         ModerationLog[] @relation("ModeratorUser")
  
  // Админ запись если есть
  admin                 Admin?
}

// Администраторы бота
model Admin {
  id          Int       @id @default(autoincrement())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id])
  role        AdminRole @default(MODERATOR)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, guildId])
}

// Роли администраторов
enum AdminRole {
  OWNER
  ADMIN
  MODERATOR
}

// Типы модераторских действий
enum ActionType {
  BAN
  UNBAN
  KICK
  MUTE
  UNMUTE
  WARN
  UNWARN
  TIMEOUT
  REMOVE_TIMEOUT
  NOTE
  SLOWMODE
  LOCK
  UNLOCK
  CLEAR
  ROLE_ADD
  ROLE_REMOVE
}

// Логи модерации
model ModerationLog {
  id            Int         @id @default(autoincrement())
  
  // Сервер
  guildId       String
  guild         Guild       @relation(fields: [guildId], references: [id])
  
  // Пользователь который был модерирован
  targetId      String
  target        User        @relation("TargetUser", fields: [targetId], references: [id])
  
  // Модератор который выполнил действие
  moderatorId   String
  moderator     User        @relation("ModeratorUser", fields: [moderatorId], references: [id])
  
  // Тип действия
  action        ActionType
  
  // Причина
  reason        String?
  
  // Длительность (для мутов/таймаутов) в секундах
  duration      Int?
  
  // Дополнительные данные в JSON
  metadata      Json?
  
  // Время создания
  createdAt     DateTime    @default(now())

  @@index([guildId])
  @@index([targetId])
  @@index([moderatorId])
  @@index([action])
  @@index([createdAt])
}

// Настройки сервера
model GuildSettings {
  id                  Int       @id @default(autoincrement())
  guildId             String    @unique
  
  // ID канала для логов модерации
  modLogChannelId     String?
  
  // ID роли для мута
  muteRoleId          String?
  
  // Prefix для команд
  prefix              String    @default("!")
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Удалённые сообщения
model DeletedMessage {
  id            Int       @id @default(autoincrement())
  guildId       String
  channelId     String
  channelName   String
  authorId      String
  authorName    String
  content       String
  hasAttachment Boolean   @default(false)
  attachmentUrl String?
  hasEmbed      Boolean   @default(false)
  embedTitle    String?
  isBot         Boolean   @default(false)
  deletedById   String
  deletedByName String
  createdAt     DateTime  @default(now())

  @@index([guildId])
  @@index([channelId])
  @@index([authorId])
  @@index([deletedById])
}

// Статистика серверов (онлайн/офлайн пользователи)
model GuildStats {
  id              Int       @id @default(autoincrement())
  guildId         String
  totalMembers    Int       @default(0)
  onlineMembers   Int       @default(0)
  offlineMembers  Int       @default(0)
  idleMembers     Int       @default(0)
  dndMembers      Int       @default(0)
  timestamp       DateTime  @default(now())

  @@index([guildId])
  @@index([timestamp])
}

// ==================== СИСТЕМА УРОВНЕЙ И ОПЫТА ====================

// Уровни пользователей на сервере
model UserLevel {
  id          Int       @id @default(autoincrement())
  guildId     String
  userId      String
  xp          Int       @default(0)
  level       Int       @default(0)
  totalXp     Int       @default(0)
  messageCount Int      @default(0)
  voiceMinutes Int      @default(0)
  lastMessageAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([level])
  @@index([totalXp])
}

// Награды за уровни
model LevelReward {
  id          Int       @id @default(autoincrement())
  guildId     String
  level       Int
  roleId      String    // ID роли которая выдается
  createdAt   DateTime  @default(now())

  @@unique([guildId, level])
  @@index([guildId])
}

// Настройки системы уровней
model LevelSettings {
  id                  Int       @id @default(autoincrement())
  guildId             String    @unique
  enabled             Boolean   @default(true)
  xpPerMessage        Int       @default(15)
  xpPerVoiceMinute    Int       @default(5)
  xpCooldown          Int       @default(60)  // секунды между получением XP
  levelUpChannelId    String?   // канал для уведомлений о повышении уровня
  levelUpMessage      String?   // кастомное сообщение
  ignoredChannels     String[]  // каналы где не начисляется XP
  ignoredRoles        String[]  // роли которые не получают XP
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ==================== АВТОМОДЕРАЦИЯ ====================

// Настройки автомодерации
model AutoModSettings {
  id                  Int       @id @default(autoincrement())
  guildId             String    @unique
  
  // Анти-спам
  antiSpamEnabled     Boolean   @default(false)
  antiSpamMaxMessages Int       @default(5)    // макс сообщений
  antiSpamInterval    Int       @default(5)    // за сколько секунд
  antiSpamAction      String    @default("warn") // warn, mute, kick, ban
  antiSpamMuteDuration Int      @default(300)  // секунды
  
  // Фильтр слов
  wordFilterEnabled   Boolean   @default(false)
  bannedWords         String[]  // запрещенные слова
  wordFilterAction    String    @default("delete") // delete, warn, mute
  
  // Анти-ссылки
  antiLinksEnabled    Boolean   @default(false)
  allowedDomains      String[]  // разрешенные домены
  antiLinksAction     String    @default("delete")
  
  // Анти-капс
  antiCapsEnabled     Boolean   @default(false)
  antiCapsPercentage  Int       @default(70)   // % заглавных букв
  antiCapsMinLength   Int       @default(10)   // мин длина сообщения
  
  // Анти-эмодзи спам
  antiEmojiEnabled    Boolean   @default(false)
  antiEmojiMax        Int       @default(10)   // макс эмодзи в сообщении
  
  // Игнорируемые роли и каналы
  ignoredRoles        String[]
  ignoredChannels     String[]
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ==================== СИСТЕМА ТИКЕТОВ ====================

// Настройки тикетов
model TicketSettings {
  id                  Int       @id @default(autoincrement())
  guildId             String    @unique
  enabled             Boolean   @default(true)
  categoryId          String?   // категория для тикетов
  supportRoleId       String?   // роль поддержки
  logChannelId        String?   // канал для логов тикетов
  welcomeMessage      String?   // сообщение при создании тикета
  maxTicketsPerUser   Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Тикеты
model Ticket {
  id            Int           @id @default(autoincrement())
  guildId       String
  channelId     String        @unique
  userId        String        // создатель тикета
  ticketNumber  Int           @default(0) // номер тикета на сервере
  subject       String?
  status        TicketStatus  @default(OPEN)
  claimedBy     String?       // кто взял тикет
  closedBy      String?       // кто закрыл
  closedReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  closedAt      DateTime?
  
  messages      TicketMessage[]

  @@index([guildId])
  @@index([ticketNumber])
  @@index([userId])
  @@index([status])
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
}

// Сообщения в тикетах
model TicketMessage {
  id          Int       @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  username    String
  content     String
  createdAt   DateTime  @default(now())

  @@index([ticketId])
}

// ==================== ГОЛОСОВАНИЯ И ОПРОСЫ ====================

// Опросы
model Poll {
  id          Int           @id @default(autoincrement())
  guildId     String
  channelId   String
  messageId   String        @unique
  creatorId   String
  question    String
  options     PollOption[]
  multipleChoice Boolean    @default(false)
  anonymous   Boolean       @default(false)
  endsAt      DateTime?
  status      PollStatus    @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([guildId])
  @@index([status])
}

enum PollStatus {
  ACTIVE
  ENDED
  CANCELLED
}

// Варианты ответов в опросе
model PollOption {
  id          Int         @id @default(autoincrement())
  pollId      Int
  poll        Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text        String
  emoji       String?
  votes       PollVote[]

  @@index([pollId])
}

// Голоса в опросе
model PollVote {
  id          Int         @id @default(autoincrement())
  optionId    Int
  option      PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId      String
  createdAt   DateTime    @default(now())

  @@unique([optionId, userId])
  @@index([userId])
}

// ==================== РЕАКЦИИ ДЛЯ РОЛЕЙ ====================

// Сообщения с реакциями для ролей
model ReactionRole {
  id          Int       @id @default(autoincrement())
  guildId     String
  channelId   String
  messageId   String
  emoji       String    // эмодзи (unicode или id кастомного)
  roleId      String    // роль которая выдается
  createdAt   DateTime  @default(now())

  @@unique([messageId, emoji])
  @@index([guildId])
  @@index([messageId])
}
